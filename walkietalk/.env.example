# Supabase project URL (Project Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (Project Settings -> API -> anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL of the Socket.io signaling server (e.g. http://localhost:3000 or your Railway URL)
EXPO_PUBLIC_SIGNALING_SERVER_URL=http://localhost:3000
